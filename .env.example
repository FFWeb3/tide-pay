# Supabase Configuration
# Obtain these from: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_SUPABASE_PUBLISHABLE_KEY=your-key
# Iron Session Encryption Secret (minimum 32 characters long)
# Generate a random 32+ character string using: openssl rand -base64 32
VITE_SESSION_ENCRYPTION_KEY=your-32-character-session-secret-key
